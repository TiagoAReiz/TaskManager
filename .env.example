# Exemplo de variáveis de ambiente
# Copie este arquivo para .env (que é ignorado pelo Git) e defina valores próprios.
#   cp .env.example .env
# Nunca commite o arquivo .env com valores reais.

# Banco de Dados
POSTGRES_DB=taskmaster
POSTGRES_USER=taskmaster_user
POSTGRES_PASSWORD=change-me

# JWT (HMAC-SHA: use no mínimo 32 caracteres aleatórios)
# Gere um valor com: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-chars
JWT_EXPIRATION=86400000

# Aplicação
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# Log
LOGGING_LEVEL_COM_TIAGOREIZ=DEBUG
